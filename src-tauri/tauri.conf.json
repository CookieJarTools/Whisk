{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Whisk",
  "version": "0.1.1",
  "identifier": "com.cookiejar.whisk",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Whisk",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 560,
        "decorations": false,
        "backgroundColor": "#0f1011"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "CookieJarTools",
    "homepage": "https://github.com/CookieJarTools/Whisk",
    "shortDescription": "A small, fast code editor",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhGM0Y0NEY5ODE1NkY3MDIKUldRQzkxYUIrVVEvanhUSFYzYW4zVXJFelRUd1FYcEx5Zk9SUkEyTHBJamtFRkkrV1F3cE1UK0EK",
      "endpoints": [
        "https://github.com/CookieJarTools/Whisk/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
